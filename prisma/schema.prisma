generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

// User model for both Students and Club Admins
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  rollNumber    String?   // New field for Executive Registration
  password      String?   // Hashed password
  emailVerified DateTime?
  role          Role      @default(STUDENT)
  isApproved    Boolean   @default(true) // Executives will have this set to false initially
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Student relation to their program applications
  applications  Application[]
  requests AdminRequest[]
}

// Presenter Program Enrollment Application
model Application {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          String?        // Wapas add kiya (UI ke liye)
  semester        String?        // Wapas add kiya (UI ke liye)
  topicInterested String         @default("Dynamic Topic") 
  dynamicData     String?        // Saara data isme jayega
  status          AppStatus      @default(WAITING)
  appliedAt       DateTime       @default(now())
  hasNudged       Boolean        @default(false)
  nudgeDate       DateTime?

  weeklySlot      WeeklySlot?    @relation(fields: [weeklySlotId], references: [id])
  weeklySlotId    String?
}

// Weekly Bulletin Slot (Manages the 2 students per week logic)
model WeeklySlot {
  id             String        @id @default(cuid())
  weekStartDate  DateTime
  weekEndDate    DateTime
  theme          String?       // E.g., "Network Security Week"
  isPublished    Boolean       @default(false)
  
  // The 2 students selected for this week
  selectedTrainees Application[]
}

enum Role {
  STUDENT
  EXECUTIVE
  CLUB_ADMIN
}

enum AppStatus {
  WAITING        // In the queue
  SHORTLISTED    // Selected by Auto-Queue or Manual PnC
  SCREENING_DONE // Passed the communication test
  COMPLETED      // Video featured
  REJECTED
}

// --- DYNAMIC FORM BUILDER MODELS ---

model FormField {
  id          String    @id @default(cuid())
  fieldName   String    // System name (e.g., "github_link", "semester")
  fieldLabel  String    // Display name (e.g., "GitHub Profile Link", "Select Semester")
  fieldType   FieldType // TEXT, DROPDOWN, FILE_UPLOAD
  options     String[]  // Dropdown options (e.g., ["1st Sem", "2nd Sem", "3rd Sem"]) - Empty if TEXT/FILE
  isRequired  Boolean   @default(true)
  isActive    Boolean   @default(true) // Admin can hide a field without deleting it
  orderIndex  Int       @default(0)    // To sort fields up and down in the form
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum FieldType {
  TEXT
  DROPDOWN
  FILE_UPLOAD
  CHECKBOX
}

// --- EXECUTIVE ACTION REQUESTS ---
model AdminRequest {
  id          String   @id @default(cuid())
  executiveId String
  executive   User     @relation(fields: [executiveId], references: [id], onDelete: Cascade)
  actionType  String   // e.g., "UPDATE_MAIL_TEMPLATE", "PUBLISH_SLOT"
  payload     String   // The new content they want to save (Store as JSON string)
  status      ReqStatus @default(PENDING)
  createdAt   DateTime @default(now())
}

enum ReqStatus {
  PENDING
  APPROVED
  REJECTED
}