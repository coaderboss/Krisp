generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

// User model for Students, Executives, and Club Admins
model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  password          String?   // Hashed password
  role              Role      @default(STUDENT)
  isApproved        Boolean   @default(true) // Executives will have this set to false initially
  image             String?
  emailVerified     DateTime?

  // --- NAYA: EXTENDED PROFILE DATA ---
  rollNumber        String?   
  college           String?
  department        String?
  isProfileComplete Boolean   @default(false) // Triggers mandatory onboarding flow

  // --- NAYA: EXECUTIVE GAMIFICATION & TRACKING ---
  credits           Int       @default(0)       // +15 for approval, 0 for rejection
  approvedRequests  Int       @default(0)
  rejectedRequests  Int       @default(0)

  // --- NAYA: ACCESS CONTROL & SECURITY ---
  isBlacklisted     Boolean   @default(false)
  accountStatus     String    @default("ACTIVE") // ACTIVE, SUSPENDED, DELETED

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // FORGOT PASSWORD TOKENS
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?

  // Relations
  applications      Application[]
  requests          AdminRequest[]
  formResponses     FormResponse[]
  attendanceRecords AttendanceRecord[]
}

// ==========================================
// THE UNIVERSAL FORM ENGINE (SaaS Level)
// ==========================================

enum FormMode {
  QUEUE
  NORMAL
  EVENT
}

model Form {
  id              String         @id @default(cuid())
  title           String
  description     String?        @db.Text
  isMaster        Boolean        @default(false) // True ONLY for the main Bulletin Form
  isActive        Boolean        @default(true)  // Open/Close form toggle
  
  // --- NEW: FORM MODES & DECLARATION ---
  execVaultAccess Boolean        @default(true)
  formMode        FormMode       @default(NORMAL)
  
  instructionText String?        @db.Text // Premium Instruction Page
  hasDeclaration  Boolean        @default(false)
  declarationText String?        @db.Text
  
  questions       FormQuestion[]
  responses       FormResponse[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model FormQuestion {
  id            String    @id @default(cuid())
  formId        String
  form          Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  
  fieldName     String    // System ID (e.g., "github_link")
  fieldLabel    String    // Display Name
  fieldType     FieldType
  options       String[]  // Array for Dropdowns/Checkboxes
  
  isRequired    Boolean   @default(true)
  isHighlighted Boolean   @default(false) // Pin to dashboard cards
  orderIndex    Int       @default(0)
  
  // --- NAYA: GRANULAR INPUT CONTROLS ---
  placeholder   String?   // Helper text inside the input
  minLength     Int?      // Text validation
  maxLength     Int?      // Number/Text validation (Word limit or Max Value)
  isMultiSelect Boolean   @default(false) // Single vs Multi Checkbox/Dropdown
  regex         String?   // Advanced string validation
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// General responses for any club event or form
model FormResponse {
  id          String   @id @default(cuid())
  formId      String
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  answersData String   @db.Text // Stored as strict JSON
  submittedAt DateTime @default(now())

  @@unique([formId, userId]) // Limits to 1 submission per form per user
}

enum FieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DROPDOWN
  FILE_UPLOAD
  CHECKBOX
}

// ==========================================
// WEEKLY BULLETIN SPECIFIC PIPELINE
// ==========================================

// Master Bulletin Enrollment (Maintains slot and status logic)
model Application {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  course          String?        
  semester        String?        
  topicInterested String         @default("Dynamic Topic") 
  dynamicData     String?        @db.Text // Serialized JSON 
  highlightedData String?        @db.Text
  
  status          AppStatus      @default(WAITING)
  appliedAt       DateTime       @default(now())
  hasNudged       Boolean        @default(false)
  nudgeDate       DateTime?

  weeklySlot      WeeklySlot?    @relation(fields: [weeklySlotId], references: [id])
  weeklySlotId    String?
}

// Weekly Slot Management
model WeeklySlot {
  id               String        @id @default(cuid())
  weekStartDate    DateTime
  weekEndDate      DateTime
  theme            String?       
  isPublished      Boolean       @default(false)
  
  selectedTrainees Application[]
}

// ==========================================
// SYSTEM AUDIT & SETTINGS
// ==========================================

model AdminRequest {
  id          String    @id @default(cuid())
  executiveId String
  executive   User      @relation(fields: [executiveId], references: [id], onDelete: Cascade)
  actionType  String    
  payload     String    @db.Text // JSON configuration
  status      ReqStatus @default(PENDING)
  createdAt   DateTime  @default(now())
}

model ClubSettings {
  id           String   @id @default("global")
  mailTemplate String   @default("Hello {{name}},\n\nYour presentation is scheduled.")
  
  // --- DYNAMIC MEDIA ENGINE (HOME PAGE) ---
  mediaTitle   String   @default("Featured Cyber Bulletin Episode")
  mediaLimit   Int      @default(1)
  mediaUrls    String   @default("[]") // JSON Array of URLs
  
  // --- SMTP SERVER CONFIGURATION ---
  smtpEmail    String?
  smtpPassword String?
  smtpHost     String?  @default("smtp.gmail.com")
  smtpPort     Int?     @default(465)
  
  updatedAt    DateTime @updatedAt
}

enum Role {
  STUDENT
  EXECUTIVE
  CLUB_ADMIN
}

enum AppStatus {
  WAITING        
  SHORTLISTED    
  SCREENING_DONE 
  COMPLETED      
  REJECTED
}

enum ReqStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==========================================
// CALENDAR & EVENT MANAGEMENT
// ==========================================

model ClubEvent {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  eventType   String    @default("WORKSHOP") // WORKSHOP, MEETING, SHOOT, DEADLINE
  eventDate   DateTime  
  
  // Link to Attendance Session if this event requires check-in
  attendanceSession AttendanceSession?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}




enum AttendanceType {
  MANUAL
  TIMER
}

enum AttendanceMode {
  QR
  CODE
}

model AttendanceSession {
  id          String         @id @default(cuid())
  title       String
  date        DateTime
  type        AttendanceType @default(MANUAL)
  mode        AttendanceMode @default(CODE)
  
  deadline    DateTime?      // If type is TIMER
  
  secretCode  String?        @unique // For CODE mode
  qrPayload   String?        @unique // For QR mode (Secure hash)
  
  isActive    Boolean        @default(true)
  
  // 🟢 FIX: Added the missing opposite relation fields linking back to ClubEvent
  eventId     String?        @unique
  event       ClubEvent?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  records     AttendanceRecord[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  
  sessionId   String
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  markedAt    DateTime @default(now())

  // SECURITY: Ek session mein ek user sirf ek baar entry le sakta hai
  @@unique([sessionId, userId])
}